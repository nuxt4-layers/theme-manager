{
  "name": "@nuxt4-layers/theme-manager",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Nuxt 4 foundation capability for semantic presentation theme definition, resolution and management.",
  "exports": {
    ".": "./nuxt.config.ts",
    "./contracts": "./contracts/index.ts",
    "./capability": "./capability.json",
    "./presentation.css": "./assets/css/main.css"
  },
  "files": [
    "app",
    "server",
    "shared",
    "contracts",
    "capability.json",
    "nuxt.config.ts",
    "README.md",
    "assets"
  ],
  "scripts": {
    "dev:prepare": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm check:theme",
    "check:theme": "node scripts/generate-theme-api.mjs --check",
    "generate:theme": "node scripts/generate-theme-api.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "nuxt": "^4.6.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3",
    "vue": "3.5.43",
    "vue-tsc": "^3.0.8",
    "@tailwindcss/vite": "^4.1.13",
    "tailwindcss": "^4.1.13"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
